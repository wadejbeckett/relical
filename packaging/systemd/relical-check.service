# Relical weekly repository check: verifies every repository's structure
# and reads back 5% of its data. Started by relical-check.timer.
[Unit]
Description=Relical weekly repository check
After=network-online.target
Wants=network-online.target

# A check that starts while a backup is still running fails on relical's own
# lock and is not retried until next week: Persistent=true only catches up a
# run that was missed entirely, not one that ran and failed.

[Service]
Type=oneshot
# "%%" is a literal "%" in a unit file.
ExecStart=/usr/local/lib/relical/relical check --all --read-data-subset 5%%
Nice=19
IOSchedulingClass=idle
