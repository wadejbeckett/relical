# Relical weekly repository check: verifies every repository's structure
# and reads back 5% of its data. Started by relical-check.timer.
[Unit]
Description=Relical weekly repository check
After=network-online.target
Wants=network-online.target

# A check that starts while the backup (or its retention) is still running
# waits up to 2 hours for relical's run lock, then fails and is not retried
# until next week: Persistent=true only catches up a run that was missed
# entirely, not one that ran and failed.

[Service]
Type=oneshot
# "%%" is a literal "%" in a unit file.
ExecStart=/usr/local/lib/relical/relical check --all --read-data-subset 5%%
# A stop sends SIGTERM: relical stops restic, records what it has and
# exits. 15 minutes covers that; restic gets 60 seconds to remove its lock
# before it is killed.
TimeoutStopSec=15min
# A hung check must not run into the next week's (every sftp: destination
# already gets ssh connect and keepalive timeouts). For Type=oneshot the
# start timeout is the one that applies; RuntimeMaxSec= is ignored.
TimeoutStartSec=20h
Nice=19
IOSchedulingClass=idle
# relical exits 4 when it is stopped (systemctl stop, a reboot): a
# deliberate stop is not a failure. A run stopped by TimeoutStartSec= is
# still one, because systemd records Result=timeout whatever the exit code.
SuccessExitStatus=4
