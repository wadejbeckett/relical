# Relical nightly backup of every subscription in the inventory, then
# retention (relical backup --all applies it itself at the end, unless
# the run was stopped). Started by relical-backup.timer. Install to
# /etc/systemd/system/; local changes belong in a drop-in
# (systemctl edit relical-backup.service).
[Unit]
Description=Relical nightly backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The configuration defaults to /etc/relical/config.json.
ExecStart=/usr/local/lib/relical/relical backup --all
# A stop (systemctl stop, a reboot, TimeoutStartSec= running out) sends
# SIGTERM: relical stops restic, records what it has, skips retention and
# exits. 15 minutes covers that; restic gets 60 seconds to remove its lock before it is
# killed.
TimeoutStopSec=15min
# A last resort against a run that hangs (every sftp: destination already
# gets ssh connect and keepalive timeouts): systemd stops the run after 20
# hours, before the next night's. For Type=oneshot the start timeout is the
# one that applies; RuntimeMaxSec= is ignored.
TimeoutStartSec=20h
# The backup yields CPU and disk to the sites and mail it is backing up.
Nice=19
IOSchedulingClass=idle
