# Installed by the Relical Backup extension for Plesk; rewritten on every
# install and upgrade, so local changes belong in a drop-in
# (systemctl edit relical-backup.service).
[Unit]
Description=Relical nightly backup
After=network-online.target
Wants=network-online.target
# Until the destination is saved in the extension's settings there is no
# configuration, and the run is skipped rather than failed.
ConditionPathExists=/etc/relical/config.json

[Service]
Type=oneshot
ExecStart=/usr/local/lib/relical/relical -config /etc/relical/config.json backup --all
# `backup --all` runs retention (forget) itself at the end of the run,
# unless it was stopped; a stop or a reboot therefore never starts a prune.
# A stop waits this long for relical to finish its SIGTERM handling.
TimeoutStopSec=15min
# Last resort against a run that hangs (a stalled SFTP session): the next
# night's timer cannot start while this one is active. For Type=oneshot the
# whole run is the start, so TimeoutStartSec= bounds it (RuntimeMaxSec= has
# no effect on oneshot services); a timeout counts as a failure.
TimeoutStartSec=20h
# The backup yields CPU and disk to the sites and mail it is backing up.
Nice=19
IOSchedulingClass=idle
