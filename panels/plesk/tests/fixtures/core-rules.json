{
    "about": "Names both the core (core/internal/inventory) and the Plesk extension (CoreRules) must accept or refuse. The extension's CoreRulesTest reads this file; the core's inventory tests should read it too, so the two copies of the rules cannot drift.",
    "subscription_names": {
        "accept": ["example.test", "a.b.example.test", "xn--bcher-kva.example.test", "1-2.example.test", "x.y"],
        "refuse": ["", "localhost", "Example.test", "bücher.example.test", "-example.test", "example-.test", "example.test.", ".example.test", "exa mple.test", "example..test", "_server"]
    },
    "sys_users": {
        "accept": ["exampleuser", "john.smith", "_svc", "a", "web-user_1", "j.s.", "abcdefghijklmnopqrstuvwxyz012345"],
        "refuse": ["", "John", ".john", "-john", "1john", "john smith", "john@x", "jöhn", "abcdefghijklmnopqrstuvwxyz0123456"]
    },
    "databases": {
        "accept": ["example_wp", "wp$1", "a-b", "_x", "9db", "Shop_DB", "phpmy", "sysadmin", "my_phpmyadmin", "mysql2", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
        "refuse": ["", "-x", "$x", "x y", "x`; DROP", "x.y", "mysql", "MySQL", "information_schema", "performance_schema", "SYS", "sys", "psa", "apsc", "horde", "roundcubemail", "atmail", "sitebuilder5", "phpmyadmin", "phpMyAdmin2", "phpmyadmin_old", "PHPMYADMINBACKUP", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
    },
    "homes": {
        "files_roots": ["/var/www/vhosts"],
        "accept": [
            {"name": "example.test", "home": "/var/www/vhosts/example.test"}
        ],
        "refuse": [
            {"name": "example.test", "home": "/var/www/vhosts/other.test"},
            {"name": "example.test", "home": "/var/www/vhosts"},
            {"name": "example.test", "home": "/var/www/vhosts/example.test/"},
            {"name": "example.test", "home": "/var/www/vhosts/example.test/httpdocs"},
            {"name": "example.test", "home": "/var/www/vhosts/x/../example.test"},
            {"name": "example.test", "home": "/home/example.test"},
            {"name": "example.test", "home": ""}
        ]
    }
}
